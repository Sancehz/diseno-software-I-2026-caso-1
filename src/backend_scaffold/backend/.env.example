# =============================================================================
# DUA STREAMLINER - ENVIRONMENT CONFIGURATION
# =============================================================================
# System configurations, parameters, and policies maintained in source code
# Resource allocations documented for deployment reference
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_NAME=dua-streamliner
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# CORS Configuration
CORS_ORIGINS=http://localhost:3001,https://yourdomain.com
CORS_CREDENTIALS=true

# Rate Limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Encryption
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dua_streamliner
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_SSL=false

# Connection Pool Settings (max 100 concurrent connections to start)
DB_POOL_MIN=10
DB_POOL_MAX=100
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Row-Level Security
DB_RLS_ENABLED=true

# -----------------------------------------------------------------------------
# AWS S3 CONFIGURATION (Archive Storage)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET_NAME=dua-streamliner-archive
S3_BUCKET_REGION=us-east-1

# Archive Policy (1 month retention for production data)
ARCHIVE_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# FILE UPLOAD CONFIGURATION
# -----------------------------------------------------------------------------
# Default payload size: 1MB, File uploads: 10MB
MAX_PAYLOAD_SIZE=1048576
MAX_FILE_UPLOAD_SIZE=10485760

# Allowed file types for upload
ALLOWED_FILE_TYPES=.docx,.doc,.xlsx,.xls,.pdf,.jpg,.jpeg,.png

# Temporary upload directory
UPLOAD_DIR=/tmp/dua-uploads

# -----------------------------------------------------------------------------
# AI/ML CONFIGURATION (OpenAI API for document processing)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.2

# OCR Configuration (Tesseract)
OCR_LANGUAGE=spa+eng
OCR_PAGE_SEGMENTATION_MODE=3

# -----------------------------------------------------------------------------
# RBAC CONFIGURATION
# -----------------------------------------------------------------------------
# Role-Based Access Control
# Roles: ADMIN, SUPPORT, CUSTOMS_OFFICER
DEFAULT_USER_ROLE=CUSTOMS_OFFICER

# Policy-Based Access Control (PBAC)
# Geographic Restriction: Costa Rica only
ALLOWED_COUNTRIES=CR
GEOLOCATION_ENABLED=true

# -----------------------------------------------------------------------------
# OBSERVABILITY CONFIGURATION
# -----------------------------------------------------------------------------
# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana Dashboard
GRAFANA_ENABLED=true
GRAFANA_PORT=3001

# Application Insights / Logging
LOGGING_ENABLED=true
LOG_FILE_PATH=/var/log/dua-streamliner
LOG_ROTATION_MAX_SIZE=10m
LOG_ROTATION_MAX_FILES=14

# Event Tracking
TRACK_LOGIN_EVENTS=true
TRACK_FILE_UPLOADS=true
TRACK_REPORT_GENERATION=true
TRACK_FAILED_ATTEMPTS=true

# -----------------------------------------------------------------------------
# AVAILABILITY & SCALING CONFIGURATION
# -----------------------------------------------------------------------------
# Target uptime: 99.9% (~100 offline hours annually)
MAINTENANCE_MODE=false
HEALTH_CHECK_INTERVAL_MS=30000

# Kubernetes/EKS Configuration References
# (Actual deployment managed via Helm charts)
K8S_NAMESPACE=dua-streamliner
K8S_REPLICAS=3
K8S_CPU_REQUEST=500m
K8S_CPU_LIMIT=1000m
K8S_MEMORY_REQUEST=512Mi
K8S_MEMORY_LIMIT=1Gi

# Load Balancing (future consideration)
LOAD_BALANCER_ENABLED=false

# Caching (future consideration based on demand)
CACHE_ENABLED=false
CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# DEVOPS CONFIGURATION
# -----------------------------------------------------------------------------
# Cronjob schedules (cron syntax)
ARCHIVE_CLEANUP_CRON=0 2 * * *
DB_BACKUP_CRON=0 3 * * *
METRICS_AGGREGATION_CRON=*/15 * * * *

# GitHub Actions Integration
CI_CD_ENABLED=true

# -----------------------------------------------------------------------------
# BUSINESS LOGIC PARAMETERS
# -----------------------------------------------------------------------------
# Document Processing Algorithm Parameters
CONFIDENCE_THRESHOLD=0.75
MIN_FIELD_CONFIDENCE=0.60
SEMANTIC_SIMILARITY_THRESHOLD=0.80

# Template Matching
FUZZY_MATCH_THRESHOLD=85

# Report Generation
MAX_CONCURRENT_REPORTS=5
REPORT_GENERATION_TIMEOUT_MS=300000

# Data Validation
FIELD_VALIDATION_STRICT_MODE=false
AUTO_CORRECTION_ENABLED=true

# -----------------------------------------------------------------------------
# INTEGRATION POINTS
# -----------------------------------------------------------------------------
# External Systems (future integrations)
CUSTOMS_API_ENDPOINT=
CUSTOMS_API_KEY=
MINISTERIO_HACIENDA_ENDPOINT=

# Webhook Configuration
WEBHOOK_ENABLED=false
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT_MS=10000
